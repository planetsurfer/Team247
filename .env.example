# ── LLM: Alibaba Cloud ModelStudio (Bailian) "compatible-mode" — OpenAI-compatible ──
# Copy to .env and fill LLM_API_KEY. Per-function model routing below lets you assign a
# different model to each LLM call; any unset row falls back to LLM_MODEL. Confirm exact
# model ids on your ModelStudio console.
LLM_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-max                   # fallback for any purpose not routed below

# Per-function model routing (each falls back to LLM_MODEL if unset)
LLM_MODEL_AGENT=qwen-max             # agent.py     — generate agent spec
LLM_MODEL_REFINE=qwen-max            # refine.py    — patch agent spec from gaps
LLM_MODEL_CANDIDATE=qwen-max         # candidate.py — generate candidate solve code
LLM_MODEL_CLASSIFY=qwen-turbo       # classify.py  — role → SSOC classification (JSON)
LLM_MODEL_BATTERY_RUBRIC=qwen-plus   # battery.py   — rubric items (JSON)
LLM_MODEL_BATTERY_GRADER=qwen-plus   # battery.py   — grader code (JSON)
LLM_MODEL_SMOKE=qwen-turbo           # smoke_test.py — connectivity ping

# Optional tuning (defaults shown)
MAX_PARALLEL=4
SANDBOX_TIMEOUT=20
DATA_XLSX=data/skillsfuture.xlsx
